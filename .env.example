# Google Gemini API Key (Required for voice assistant & live streaming)
GEMINI_API_KEY=your_gemini_api_key_here

# Voice Model Configuration
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Default Voice Persona (Aoede, Puck, Charon, Fenrir, Kore)
DEFAULT_VOICE=Aoede

# Server Config
HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# MongoDB Database Configuration (Atlas or Local)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=jack_receptionist

# Authentication & JWT Configuration
JWT_SECRET=your_strong_random_jwt_secret_key_here
JWT_EXPIRE_MINUTES=10080
OTP_EXPIRE_SECONDS=30
OTP_MAX_ATTEMPTS=3

# SMTP Email Configuration (Optional for real email OTP dispatch)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=Jack AI Receptionist <noreply@hrenterprises.com>
SMTP_USE_TLS=true

# Twilio Telephony Configuration (Optional for real phone calls & SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
